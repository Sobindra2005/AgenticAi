{
  "name": "agentic-ai-playground",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "esbuild src/client/index.tsx --bundle --minify --format=esm --outfile=public/client.js",
    "watch:client": "esbuild src/client/index.tsx --bundle --format=esm --outfile=public/client.js --watch",
    "build": "npm run build:client",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@langchain/core": "^1.2.13",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/ollama": "^1.3.0",
    "@langchain/tavily": "^1.2.0",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.38.4",
    "express": "^5.2.1",
    "langchain": "^1.5.14",
    "markdown-it": "^15.0.2",
    "postgres": "^3.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.30.2",
    "esbuild": "^0.28.2",
    "tsx": "latest",
    "typescript": "latest"
  }
}
