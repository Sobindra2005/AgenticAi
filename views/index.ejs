<!-- Application Header -->
<header class="app-header">
  <div class="brand-group">
    <div class="brand-logo">
      <div class="logo-dot"></div>
      <span>Agentic AI Studio</span>
    </div>
    <div class="model-badges">
      <span class="badge badge-accent">LangGraph v1.4</span>
      <span class="badge badge-cyan">DeepSeek-R1</span>
      <span class="badge badge-orange">Tavily Search</span>
    </div>
  </div>

  <div class="nav-tabs">
    <button id="nav-btn-threads" class="nav-tab-btn active" title="Browse all research threads">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
        stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="7" height="7"></rect>
        <rect x="14" y="3" width="7" height="7"></rect>
        <rect x="14" y="14" width="7" height="7"></rect>
        <rect x="3" y="14" width="7" height="7"></rect>
      </svg>
      <span>Threads Hub</span>
      <span id="nav-threads-count" class="tab-badge">0</span>
    </button>
    <button id="nav-btn-workspace" class="nav-tab-btn" title="Open active research workspace">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
        stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
      </svg>
      <span id="nav-workspace-label">Active Workspace</span>
    </button>
  </div>

  <div class="header-actions">
    <button id="btn-new-thread-top" class="btn-primary-accent" title="Start a fresh isolated research thread">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
        stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
      <span>New Thread</span>
    </button>
  </div>
</header>

<!-- VIEW 1: Initial Threads Hub / Cards View -->
<section id="threads-view" class="threads-view">

  <div class="threads-toolbar">
    <div class="threads-search-bar">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
        stroke-linecap="round" stroke-linejoin="round" style="color: var(--muted);">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" id="threads-search" placeholder="Search threads by topic, query, or ID..." />
    </div>
    <span id="threads-stat-label" class="threads-count-badge">0 active threads</span>
  </div>

  <!-- Threads Cards Grid -->
  <div id="threads-grid" class="threads-grid">
    <!-- Populated dynamically via JS -->
  </div>
</section>

<!-- VIEW 2: Active Workspace (Scoped to Current Thread) -->
<section id="workspace-view" style="display: none; flex-direction: column; flex: 1; min-height: 0; gap: 8px;">
  <!-- Workspace Top Sub-bar -->
  <div class="workspace-topbar">
    <div class="workspace-thread-info">
      <button id="btn-back-to-threads" class="btn-secondary" title="Return to All Threads">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
          stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>All Threads</span>
      </button>

      <div class="workspace-thread-title">
        <span id="current-thread-title">Untitled Thread</span>
        <span id="current-thread-badge" class="badge" style="font-size: 10px;">#th-new</span>
      </div>
    </div>

    <div class="workspace-actions">
      <button id="btn-clear-chat" class="btn-secondary" title="Clear messages in this thread">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
        </svg>
        <span>Clear Thread</span>
      </button>

    </div>
  </div>

  <section class="workspace">
    <!-- Left Panel: Chat & Research Execution Feed -->
    <section class="panel chat-panel">
      <div id="chat-history" class="chat-history">
        <!-- Rendered chat turns for this thread -->
      </div>

      <form id="chat-form" class="chat-input-bar">
        <textarea id="chat-input" class="text-input"
          placeholder="Research courses, topics, or ask follow-ups for this thread... (Press Enter to Send)"
          rows="1"></textarea>
        <button id="btn-submit" type="submit" class="btn-send">
          <span>Research</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
            stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </button>
      </form>
    </section>

    <!-- Right Panel: Tabbed Research Vault & Telemetry -->
    <section class="panel vault-panel">
      <div class="vault-tabs">
        <button class="vault-tab-btn active" data-tab="sources">
          <span>🌐 Sources Vault</span>
          <span id="tab-sources-count" class="tab-badge">0</span>
        </button>
        <button class="vault-tab-btn" data-tab="kb">
          <span>📚 Knowledge Base</span>
          <span id="tab-kb-count" class="tab-badge">0</span>
        </button>
        <button class="vault-tab-btn" data-tab="trace">
          <span>⚡ Graph Trace</span>
          <span id="tab-trace-count" class="tab-badge">0</span>
        </button>
      </div>

      <div class="vault-body">
        <!-- TAB 1: Sources Vault -->
        <div id="tab-content-sources" class="vault-tab-content active">
          <div class="vault-toolbar" style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
            <input type="text" id="sources-search" class="search-filter" placeholder="Filter sources by title/domain..."
              style="flex: 1; min-width: 140px;" />
            <button id="btn-add-to-kb" class="btn-primary"
              style="display: none; align-items: center; gap: 6px; padding: 6px 12px; font-size: 11px; white-space: nowrap; cursor: pointer;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>Add to Knowledge Base</span>
              <span id="selected-kb-count" class="tab-badge" style="background: rgba(255, 255, 255, 0.25);">0</span>
            </button>
            <span id="sources-stat"
              style="font-family: 'DM Mono', monospace; font-size: 11px; color: var(--muted); margin-left: auto;">0
              unique sources</span>
          </div>
          <div id="sources-list" style="display: flex; flex-direction: column; gap: 10px; overflow-y: auto;">
            <div class="vault-empty">
              <span class="vault-empty-icon">🌐</span>
              <strong>No sources collected yet</strong>
              <p style="font-size: 12px;">Run a research query to gather Tavily sources.</p>
            </div>
          </div>
        </div>

        <!-- TAB 2: Knowledge Base -->
        <div id="tab-content-kb" class="vault-tab-content">
          <div class="vault-toolbar">
            <div style="display: flex; gap: 6px;">
              <button id="btn-copy-kb" class="btn-secondary" title="Copy Knowledge Base as JSON">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                </svg>
                Copy JSON
              </button>
              <button id="btn-download-kb" class="btn-secondary" title="Download as Markdown">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <polyline points="7 10 12 15 17 10" />
                  <line x1="12" y1="15" x2="12" y2="3" />
                </svg>
                Export MD
              </button>
            </div>
            <span id="kb-stat" style="font-family: 'DM Mono', monospace; font-size: 11px; color: var(--muted);">0 items
              ready</span>
          </div>
          <div id="kb-list" style="display: flex; flex-direction: column; gap: 10px; overflow-y: auto;">
            <div class="vault-empty">
              <span class="vault-empty-icon">📚</span>
              <strong>Knowledge Base Empty</strong>
              <p style="font-size: 12px;">Extracted course curricula & guides will appear here.</p>
            </div>
          </div>
        </div>

        <!-- TAB 3: Graph Execution Trace -->
        <div id="tab-content-trace" class="vault-tab-content">
          <div class="vault-toolbar">
            <span style="font-family: 'DM Mono', monospace; font-size: 11px; color: var(--muted);">LangGraph Execution
              Telemetry</span>
            <button id="btn-clear-trace" class="btn-secondary" style="font-size: 11px; padding: 3px 8px;">Clear</button>
          </div>
          <div id="trace-list"
            style="display: flex; flex-direction: column; gap: 2px; overflow-y: auto; padding: 6px 0;">
            <div class="vault-empty">
              <span class="vault-empty-icon">⚡</span>
              <strong>No trace events recorded</strong>
              <p style="font-size: 12px;">Node telemetry will log in real time as the graph executes.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </section>
</section>

<script>
  // Setup markdown renderer
  const md = window.markdownit({
    html: true,
    linkify: true,
    breaks: true
  });

  // State management per thread
  let currentThreadId = null;
  let allSources = [];
  let allKB = [];
  let traceSteps = [];
  let activeEventSource = null;
  const unselectedSourceUrls = new Set();

  // DOM Elements - Navigation & Views
  const navBtnThreads = document.getElementById('nav-btn-threads');
  const navBtnWorkspace = document.getElementById('nav-btn-workspace');
  const navThreadsCount = document.getElementById('nav-threads-count');
  const navWorkspaceLabel = document.getElementById('nav-workspace-label');
  const threadsView = document.getElementById('threads-view');
  const workspaceView = document.getElementById('workspace-view');
  const threadsGrid = document.getElementById('threads-grid');
  const threadsSearch = document.getElementById('threads-search');
  const threadsStatLabel = document.getElementById('threads-stat-label');

  // Buttons for thread creation
  const btnNewThreadTop = document.getElementById('btn-new-thread-top');
  const btnNewThreadHero = document.getElementById('btn-new-thread-hero');
  const btnNewThreadWorkspace = document.getElementById('btn-new-thread-workspace');
  const btnBackToThreads = document.getElementById('btn-back-to-threads');
  const btnClearChat = document.getElementById('btn-clear-chat');

  // Workspace Elements
  const currentThreadTitle = document.getElementById('current-thread-title');
  const currentThreadBadge = document.getElementById('current-thread-badge');
  const chatForm = document.getElementById('chat-form');
  const chatInput = document.getElementById('chat-input');
  const chatHistory = document.getElementById('chat-history');
  const btnSubmit = document.getElementById('btn-submit');

  // Vault Elements
  const sourcesList = document.getElementById('sources-list');
  const kbList = document.getElementById('kb-list');
  const traceList = document.getElementById('trace-list');
  const tabSourcesCount = document.getElementById('tab-sources-count');
  const tabKbCount = document.getElementById('tab-kb-count');
  const tabTraceCount = document.getElementById('tab-trace-count');
  const sourcesStat = document.getElementById('sources-stat');
  const kbStat = document.getElementById('kb-stat');
  const sourcesSearch = document.getElementById('sources-search');
  const btnCopyKb = document.getElementById('btn-copy-kb');
  const btnDownloadKb = document.getElementById('btn-download-kb');
  const btnClearTrace = document.getElementById('btn-clear-trace');
  const btnAddToKb = document.getElementById('btn-add-to-kb');
  const selectedKbCount = document.getElementById('selected-kb-count');

  // ==========================================
  // THREAD DATABASE API HELPERS (PostgreSQL via REST)
  // ==========================================

  let cachedThreadsList = [];

  async function getStoredThreads() {
    try {
      const res = await fetch('/api/threads');
      if (res.ok) {
        const data = await res.json();
        cachedThreadsList = Array.isArray(data?.threads) ? data.threads : [];
        updateNavThreadsCount(cachedThreadsList.length);
        return cachedThreadsList;
      }
    } catch (e) {
      console.warn("Failed to fetch threads from DB, using cache:", e);
    }
    return Array.isArray(cachedThreadsList) ? cachedThreadsList : [];
  }

  function updateNavThreadsCount(count) {
    if (navThreadsCount) navThreadsCount.textContent = count;
    if (threadsStatLabel) threadsStatLabel.textContent = `${count} active thread${count === 1 ? '' : 's'}`;
  }

  async function loadThreadData(id) {
    try {
      const res = await fetch(`/api/threads/${encodeURIComponent(id)}`);
      if (res.ok) {
        const payload = await res.json();
        return payload;
      }
    } catch (e) {
      console.error(`Failed to load thread ${id} from DB:`, e);
    }
    return { thread: null, messages: [], sources: [], kb: [], traces: [] };
  }

  async function saveThreadData(id) {
    if (!id) return;
    try {
      await fetch(`/api/threads/${encodeURIComponent(id)}/save`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          sources: allSources,
          kb: allKB,
          trace: traceSteps,
        }),
      });
    } catch (e) {
      console.error("Failed to save thread assets to DB:", e);
    }
  }

  function formatRelativeTime(timestamp) {
    if (!timestamp) return 'Just now';
    const timeVal = typeof timestamp === 'number' ? timestamp : new Date(timestamp).getTime();
    if (isNaN(timeVal)) return 'Just now';
    const diffMs = Date.now() - timeVal;
    const diffMins = Math.floor(diffMs / 60000);
    const diffHours = Math.floor(diffMins / 60);
    const diffDays = Math.floor(diffHours / 24);

    if (diffMins < 1) return 'Just now';
    if (diffMins < 60) return `${diffMins}m ago`;
    if (diffHours < 24) return `${diffHours}h ago`;
    return `${diffDays}d ago`;
  }

  // ==========================================
  // VIEW SWITCHING & RENDERING
  // ==========================================

  async function showThreadsView() {
    if (currentThreadId) {
      await saveThreadData(currentThreadId);
    }

    threadsView.style.display = 'flex';
    workspaceView.style.display = 'none';
    navBtnThreads.classList.add('active');
    navBtnWorkspace.classList.remove('active');
    await renderThreadsGrid(threadsSearch ? threadsSearch.value.trim() : '');
  }

  async function showWorkspaceView(threadId) {
    if (!threadId) {
      const threads = await getStoredThreads();
      if (threads.length > 0) {
        threadId = threads[0].id;
      } else {
        threadId = await createNewThread();
        return;
      }
    }

    if (currentThreadId && currentThreadId !== threadId) {
      await saveThreadData(currentThreadId);
    }

    currentThreadId = threadId;
    localStorage.setItem('agentic_active_thread_id', threadId);

    // Fetch full data from PostgreSQL backend
    const data = await loadThreadData(threadId);
    const thread = data.thread || cachedThreadsList.find(t => t.id === threadId);
    const title = thread ? thread.title : 'Research Thread';

    if (currentThreadTitle) currentThreadTitle.textContent = title;
    if (currentThreadBadge) currentThreadBadge.textContent = `#${threadId.slice(-6)}`;
    if (navWorkspaceLabel) navWorkspaceLabel.textContent = title.length > 18 ? title.slice(0, 18) + '...' : title;

    // Render messages from DB
    chatHistory.innerHTML = '';
    if (Array.isArray(data.messages) && data.messages.length > 0) {
      data.messages.forEach(msg => {
        if (msg.role === 'user') {
          const userMsg = document.createElement('div');
          userMsg.className = 'user-message';
          userMsg.textContent = msg.content;
          chatHistory.appendChild(userMsg);
        } else {
          const agentMsg = document.createElement('div');
          agentMsg.className = 'assistant-message';
          agentMsg.innerHTML = `
            <div class="report-content">
              ${md.render(msg.report || msg.content)}
            </div>
          `;
          chatHistory.appendChild(agentMsg);
        }
      });
    }

    allSources = data.sources || [];
    allKB = data.kb || [];
    traceSteps = data.traces || [];
    unselectedSourceUrls.clear();

    // Render Vault contents
    renderSources();
    renderKB();
    renderTrace();

    // Show workspace
    threadsView.style.display = 'none';
    workspaceView.style.display = 'flex';
    navBtnThreads.classList.remove('active');
    navBtnWorkspace.classList.add('active');

    chatHistory.scrollTop = chatHistory.scrollHeight;
    chatInput.focus();
  }
  // Render Thread Cards in the Hub Grid
  async function renderThreadsGrid(filterTerm = '') {
    const threads = await getStoredThreads();
    updateNavThreadsCount(threads.length);

    const term = filterTerm.toLowerCase();
    const filtered = threads.filter(t =>
      t.title.toLowerCase().includes(term) ||
      (t.lastSnippet && t.lastSnippet.toLowerCase().includes(term)) ||
      t.id.toLowerCase().includes(term)
    );

    let html = `
      <!-- Create New Thread Card -->
      <div id="card-create-thread" class="thread-card-create">
        <div class="thread-create-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
        </div>
        <div class="thread-create-label">+ Start New Thread</div>
        <div class="thread-create-hint">Creates an isolated session with fresh checkpoints</div>
      </div>
    `;

    if (filtered.length === 0 && term) {
      html += `
        <div style="grid-column: 1 / -1; padding: 40px; text-align: center; color: var(--muted); background: var(--panel-card); border-radius: 12px; border: 1px solid var(--line);">
          <p style="font-size: 14px;">No threads found matching "${escapeHtml(filterTerm)}".</p>
        </div>
      `;
    } else {
      filtered.forEach(thread => {
        const isActive = thread.id === currentThreadId;
        const timeStr = formatRelativeTime(thread.updatedAt || thread.createdAt);
        const snippet = thread.lastSnippet || 'New research thread ready. Enter a topic to begin.';

        html += `
          <div class="thread-card ${isActive ? 'active-thread-card' : ''}" data-id="${thread.id}">
            <div class="thread-card-header">
              <div class="thread-card-title-group">
                <div class="thread-card-title" title="${escapeHtml(thread.title)}">${escapeHtml(thread.title)}</div>
                <div class="thread-card-meta">
                  <span>#${thread.id.slice(-6)}</span>
                  <span>•</span>
                  <span>${timeStr}</span>
                </div>
              </div>
              <button class="thread-delete-btn" data-delete-id="${thread.id}" title="Delete thread">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
              </button>
            </div>

            <div class="thread-card-snippet">${escapeHtml(snippet)}</div>

            <div class="thread-card-footer">
              <div class="thread-metrics-group">
                <span class="thread-metric" title="Turns / Messages">
                  <span>💬</span>
                  <span>${thread.messageCount || 0}</span>
                </span>
                <span class="thread-metric" title="Sources Vault">
                  <span>🌐</span>
                  <span>${thread.sourceCount || 0}</span>
                </span>
                <span class="thread-metric" title="Knowledge Base items">
                  <span>📚</span>
                  <span>${thread.kbCount || 0}</span>
                </span>
              </div>
              <span class="thread-open-link">
                <span>Open Chat</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </span>
            </div>
          </div>
        `;
      });
    }

    threadsGrid.innerHTML = html;

    // Attach Click Handlers
    const createCard = document.getElementById('card-create-thread');
    if (createCard) {
      createCard.addEventListener('click', () => createNewThread());
    }

    document.querySelectorAll('.thread-card').forEach(card => {
      card.addEventListener('click', (e) => {
        if (e.target.closest('.thread-delete-btn')) return;
        const threadId = card.getAttribute('data-id');
        showWorkspaceView(threadId);
      });
    });

    document.querySelectorAll('.thread-delete-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const idToDelete = btn.getAttribute('data-delete-id');
        if (confirm("Are you sure you want to delete this research thread? All messages and sources in this thread will be removed.")) {
          await deleteThread(idToDelete);
        }
      });
    });
  }

  // Create a New Thread
  async function createNewThread(initialTitle = 'New Research Thread') {
    try {
      const res = await fetch('/api/threads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title: initialTitle }),
      });
      if (res.ok) {
        const data = await res.json();
        const threadId = data.thread.id;
        await showWorkspaceView(threadId);
        return threadId;
      }
    } catch (e) {
      console.error("Failed to create thread via API:", e);
    }
    await showThreadsView();
  }

  // Delete a Thread
  async function deleteThread(id) {
    try {
      await fetch(`/api/threads/${encodeURIComponent(id)}`, { method: 'DELETE' });
    } catch (e) {
      console.error("Failed to delete thread via API:", e);
    }

    if (currentThreadId === id) {
      currentThreadId = null;
      localStorage.removeItem('agentic_active_thread_id');
      await showThreadsView();
    } else {
      await renderThreadsGrid(threadsSearch ? threadsSearch.value.trim() : '');
    }
  }

  // Update current thread stats in threads index
  async function updateCurrentThreadMetadata(lastText = '') {
    if (!currentThreadId) return;
    const threads = await getStoredThreads();
    if (!Array.isArray(threads)) return;
    const thread = threads.find(t => t.id === currentThreadId);
    if (!thread) return;

    const updates = {
      updatedAt: Date.now(),
      messageCount: chatHistory.querySelectorAll('.user-message').length,
      sourceCount: allSources.length,
      kbCount: allKB.length,
    };

    if (lastText) {
      updates.lastSnippet = lastText.slice(0, 140);
    }

    if (thread.title === 'New Research Thread' || thread.title === 'Untitled Thread') {
      const firstUserMsg = chatHistory.querySelector('.user-message');
      if (firstUserMsg && firstUserMsg.textContent) {
        updates.title = firstUserMsg.textContent.slice(0, 48);
        if (currentThreadTitle) currentThreadTitle.textContent = updates.title;
        if (navWorkspaceLabel) navWorkspaceLabel.textContent = updates.title.length > 18 ? updates.title.slice(0, 18) + '...' : updates.title;
      }
    }

    Object.assign(thread, updates);

    try {
      await fetch(`/api/threads/${encodeURIComponent(currentThreadId)}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(updates),
      });
    } catch (e) {
      console.warn("Failed to sync thread metadata to DB:", e);
    }
  }

  // ==========================================
  // EVENT LISTENERS & NAVIGATION
  // ==========================================

  // Nav Tabs
  navBtnThreads.addEventListener('click', showThreadsView);
  navBtnWorkspace.addEventListener('click', async () => {
    if (currentThreadId) {
      await showWorkspaceView(currentThreadId);
    } else {
      const threads = await getStoredThreads();
      if (threads.length > 0) {
        await showWorkspaceView(threads[0].id);
      } else {
        await createNewThread();
      }
    }
  });

  // New Thread Buttons
  btnNewThreadTop.addEventListener('click', () => createNewThread());
  if (btnNewThreadHero) btnNewThreadHero.addEventListener('click', () => createNewThread());
  if (btnNewThreadWorkspace) btnNewThreadWorkspace.addEventListener('click', () => createNewThread());
  btnBackToThreads.addEventListener('click', showThreadsView);

  // Search Filter
  if (threadsSearch) {
    threadsSearch.addEventListener('input', (e) => {
      renderThreadsGrid(e.target.value.trim());
    });
  }

  // Clear Chat in Thread
  if (btnClearChat) {
    btnClearChat.addEventListener('click', () => {
      if (confirm("Clear all messages and vault sources for this thread?")) {
        chatHistory.innerHTML = '';
        allSources = [];
        allKB = [];
        traceSteps = [];
        renderSources();
        renderKB();
        renderTrace();
        saveThreadData(currentThreadId);
        updateCurrentThreadMetadata('Cleared thread.');
      }
    });
  }

  // Tab Switching inside Vault
  document.querySelectorAll('.vault-tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.vault-tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.vault-tab-content').forEach(c => c.classList.remove('active'));

      btn.classList.add('active');
      const tabId = 'tab-content-' + btn.getAttribute('data-tab');
      const content = document.getElementById(tabId);
      if (content) content.classList.add('active');
    });
  });

  // Auto-resize textarea
  chatInput.addEventListener('input', () => {
    chatInput.style.height = 'auto';
    chatInput.style.height = Math.min(chatInput.scrollHeight, 120) + 'px';
  });

  // Enter to send
  chatInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      chatForm.dispatchEvent(new Event('submit'));
    }
  });

  btnClearTrace.addEventListener('click', () => {
    traceSteps = [];
    renderTrace();
    saveThreadData(currentThreadId);
  });

  // Filter sources
  sourcesSearch.addEventListener('input', (e) => {
    const term = e.target.value.toLowerCase();
    const filtered = allSources.filter(s =>
      s.title.toLowerCase().includes(term) || s.url.toLowerCase().includes(term) || s.content.toLowerCase().includes(term)
    );
    renderSources(filtered);
  });

  // Copy KB as JSON
  btnCopyKb.addEventListener('click', () => {
    if (allKB.length === 0) {
      alert("Knowledge Base is currently empty.");
      return;
    }
    navigator.clipboard.writeText(JSON.stringify(allKB, null, 2)).then(() => {
      btnCopyKb.textContent = "✓ Copied!";
      setTimeout(() => {
        btnCopyKb.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Copy JSON`;
      }, 2000);
    });
  });

  // Download KB as Markdown
  btnDownloadKb.addEventListener('click', () => {
    if (allKB.length === 0) {
      alert("Knowledge Base is currently empty.");
      return;
    }
    let mdText = `# Knowledge Base Export\nGenerated: ${new Date().toLocaleString()}\nThread: ${currentThreadId || 'default'}\n\n`;
    allKB.forEach((item, idx) => {
      mdText += `## ${idx + 1}. [${item.title}](${item.sourceUrl})\n`;
      mdText += `- **Category:** ${item.category}\n`;
      mdText += `- **Domain:** ${item.domain}\n`;
      mdText += `- **Key Topics:** ${item.keyTopics.join(", ")}\n\n`;
      mdText += `> ${item.summary}\n\n---\n\n`;
    });
    const blob = new Blob([mdText], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `knowledge-base-${Date.now()}.md`;
    a.click();
    URL.revokeObjectURL(url);
  });

  // Helper to escape HTML
  function escapeHtml(str) {
    return (str || '').replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
  }

  function extractDomain(urlStr) {
    try {
      const u = new URL(urlStr);
      return u.hostname.replace(/^www\./, '');
    } catch {
      return 'web';
    }
  }

  // Add Step to Trace
  function logTrace(node, desc, time = new Date()) {
    const step = {
      id: Date.now() + Math.random(),
      node,
      desc,
      time: time.toLocaleTimeString()
    };
    traceSteps.unshift(step);
    renderTrace();
    saveThreadData(currentThreadId);
  }

  function renderTrace() {
    tabTraceCount.textContent = traceSteps.length;
    if (traceSteps.length === 0) {
      traceList.innerHTML = `
        <div class="vault-empty">
          <span class="vault-empty-icon">⚡</span>
          <strong>No trace events recorded</strong>
          <p style="font-size: 12px;">Node telemetry will log in real time as the graph executes.</p>
        </div>
      `;
      return;
    }

    traceList.innerHTML = traceSteps.map(step => {
      let iconClass = 'trace-plan';
      let iconChar = '💭';
      if (step.node === 'searchTavily') { iconClass = 'trace-search'; iconChar = '🔍'; }
      else if (step.node === 'evaluateSufficiency') { iconClass = 'trace-eval'; iconChar = '🧠'; }
      else if (step.node === 'synthesizeReport') { iconClass = 'trace-synth'; iconChar = '📝'; }

      return `
        <div class="trace-step">
          <div class="trace-icon ${iconClass}">${iconChar}</div>
          <div class="trace-info">
            <div class="trace-info-header">
              <span class="trace-node-name">${step.node}</span>
              <span class="trace-time">${step.time}</span>
            </div>
            <div class="trace-desc">${escapeHtml(step.desc)}</div>
          </div>
        </div>
      `;
    }).join('');
  }

  // Categorize sources when added to KB
  function categorizeSource(title, content) {
    const text = ((title || '') + ' ' + (content || '')).toLowerCase();
    if (text.includes("course") || text.includes("specialization") || text.includes("curriculum") || text.includes("syllabus") || text.includes("certification")) {
      return "Course";
    }
    if (text.includes("docs") || text.includes("documentation") || text.includes("api reference") || text.includes("manual")) {
      return "Documentation";
    }
    if (text.includes("tutorial") || text.includes("guide") || text.includes("how to") || text.includes("step-by-step")) {
      return "Tutorial";
    }
    if (text.includes("github.com") || text.includes("repository") || text.includes("framework")) {
      return "Resource";
    }
    return "Article";
  }

  function extractKeyTopics(title, content) {
    const combined = ((title || '') + ' ' + (content || '')).toLowerCase();
    const commonTopics = [
      "langgraph", "langchain", "agentic ai", "multi-agent", "rag", "vector database",
      "deep learning", "machine learning", "nlp", "llm", "transformers", "pytorch",
      "python", "prompt engineering", "fine-tuning", "autonomous agents", "evaluations",
      "state graph", "human-in-the-loop", "memory", "tools", "fastapi", "typescript"
    ];
    const found = commonTopics.filter(topic => combined.includes(topic));
    if (found.length === 0) {
      return (title || '').split(/\s+/).filter(w => w.length > 4).slice(0, 4);
    }
    return found.slice(0, 5);
  }

  function updateAddToKbButton() {
    const validSelected = allSources.filter(s => !allKB.some(k => k.sourceUrl === s.url) && !unselectedSourceUrls.has(s.url));
    if (selectedKbCount) selectedKbCount.textContent = validSelected.length;
    if (btnAddToKb) {
      if (validSelected.length > 0) {
        btnAddToKb.style.display = 'inline-flex';
      } else {
        btnAddToKb.style.display = 'none';
      }
    }
  }

  // Render Sources Vault
  function renderSources(itemsToRender = allSources) {
    tabSourcesCount.textContent = allSources.length;
    sourcesStat.textContent = `${allSources.length} unique sources`;
    updateAddToKbButton();

    if (itemsToRender.length === 0) {
      sourcesList.innerHTML = `
        <div class="vault-empty">
          <span class="vault-empty-icon">🌐</span>
          <strong>No sources collected</strong>
          <p style="font-size: 12px;">Run a research query to gather Tavily sources.</p>
        </div>
      `;
      return;
    }

    sourcesList.innerHTML = itemsToRender.map((s, idx) => {
      const inKB = allKB.some(k => k.sourceUrl === s.url);
      const isChecked = inKB || !unselectedSourceUrls.has(s.url);

      return `
      <div class="source-card ${inKB ? 'source-in-kb' : ''}">
        <div class="source-card-header">
          <label style="display: flex; align-items: center; gap: 8px; cursor: ${inKB ? 'default' : 'pointer'}; margin: 0; user-select: none;">
            <input 
              type="checkbox" 
              class="source-kb-cb" 
              data-url="${escapeHtml(s.url)}" 
              ${inKB ? 'checked disabled title="Already in Knowledge Base"' : (isChecked ? 'checked' : '')}
              style="width: 15px; height: 15px; accent-color: ${inKB ? 'var(--emerald)' : 'var(--accent)'}; cursor: ${inKB ? 'not-allowed' : 'pointer'};"
            />
            <span class="source-domain">${extractDomain(s.url)}</span>
          </label>
          <div style="display: flex; gap: 5px; align-items: center;">
            ${inKB ? '<span class="badge" style="color: var(--emerald); border-color: rgba(16, 185, 129, 0.35); background: rgba(16, 185, 129, 0.1); font-size: 10px;">✓ In Knowledge Base</span>' : ''}
            <span class="badge" style="font-size: 10px;">Round ${s.iteration || 1}</span>
            ${s.isNew ? '<span class="pill-new">NEW</span>' : ''}
          </div>
        </div>
        <a class="source-card-title" href="${s.url}" target="_blank" rel="noopener noreferrer">${escapeHtml(s.title)}</a>
        <div class="source-snippet" id="snippet-${idx}">${escapeHtml(s.content)}</div>
        <button class="btn-expand-snippet" onclick="toggleSnippet(${idx})">Toggle Excerpt</button>
      </div>
    `;
    }).join('');
  }

  // Handle source checkbox change via event delegation
  sourcesList.addEventListener('change', (e) => {
    const cb = e.target.closest('.source-kb-cb');
    if (cb && !cb.disabled) {
      const url = cb.getAttribute('data-url');
      if (url) {
        if (cb.checked) {
          unselectedSourceUrls.delete(url);
        } else {
          unselectedSourceUrls.add(url);
        }
        updateAddToKbButton();
      }
    }
  });

  // Add selected sources to Knowledge Base
  if (btnAddToKb) {
    btnAddToKb.addEventListener('click', () => {
      const validSelected = allSources.filter(s => !allKB.some(k => k.sourceUrl === s.url) && !unselectedSourceUrls.has(s.url));
      if (validSelected.length === 0) return;

      const existingKbUrls = new Set(allKB.map(k => k.sourceUrl));

      validSelected.forEach(source => {
        if (!existingKbUrls.has(source.url)) {
          allKB.push({
            id: source.id || Math.random().toString(36).substring(2, 9),
            title: source.title || "Untitled Source",
            sourceUrl: source.url,
            domain: extractDomain(source.url),
            category: categorizeSource(source.title, source.content || ''),
            summary: (source.content || '').slice(0, 240) + ((source.content || '').length > 240 ? '...' : ''),
            keyTopics: extractKeyTopics(source.title || '', source.content || '')
          });
          existingKbUrls.add(source.url);
        }
      });

      unselectedSourceUrls.clear();
      updateAddToKbButton();
      renderKB();
      renderSources();
      saveThreadData(currentThreadId);
      updateCurrentThreadMetadata();

      tabKbCount.classList.add('tab-badge-highlight');
      setTimeout(() => tabKbCount.classList.remove('tab-badge-highlight'), 1000);
    });
  }

  window.toggleSnippet = function (idx) {
    const el = document.getElementById('snippet-' + idx);
    if (el) el.classList.toggle('expanded');
  };

  // Render Knowledge Base
  function renderKB() {
    tabKbCount.textContent = allKB.length;
    kbStat.textContent = `${allKB.length} items ready`;

    if (allKB.length === 0) {
      kbList.innerHTML = `
        <div class="vault-empty">
          <span class="vault-empty-icon">📚</span>
          <strong>Knowledge Base Empty</strong>
          <p style="font-size: 12px;">Extracted course curricula & guides will appear here.</p>
        </div>
      `;
      return;
    }

    kbList.innerHTML = allKB.map(item => {
      const catClass = 'category-' + (item.category || 'resource').toLowerCase();
      return `
        <div class="kb-card">
          <div class="kb-card-header">
            <span class="kb-category ${catClass}">${item.category}</span>
            <span style="font-family: 'DM Mono', monospace; font-size: 11px; color: var(--muted);">${item.domain}</span>
          </div>
          <a class="kb-card-title" href="${item.sourceUrl}" target="_blank" rel="noopener noreferrer">${escapeHtml(item.title)}</a>
          <p class="kb-card-summary">${escapeHtml(item.summary)}</p>
          <div class="kb-tags">
            ${item.keyTopics.map(t => `<span class="kb-tag">${escapeHtml(t)}</span>`).join('')}
          </div>
        </div>
      `;
    }).join('');
  }

  // ==========================================
  // CHAT EXECUTION & STREAMING HANDLER
  // ==========================================

  chatForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const query = chatInput.value.trim();
    if (!query) return;

    if (!currentThreadId) {
      currentThreadId = await createNewThread(query.slice(0, 48));
    }

    // Reset input
    chatInput.value = '';
    chatInput.style.height = '48px';
    chatInput.disabled = true;
    btnSubmit.disabled = true;

    // Append User Message
    const userMsg = document.createElement('div');
    userMsg.className = 'user-message';
    userMsg.textContent = query;
    chatHistory.appendChild(userMsg);

    // Create Agent Message Container
    const agentMsgId = 'agent-' + Date.now();
    const agentMsg = document.createElement('div');
    agentMsg.className = 'assistant-message';
    agentMsg.id = agentMsgId;

    agentMsg.innerHTML = `
      <div class="research-stepper">
        <div class="stepper-header">
          <div class="stepper-status">
            <div class="spinner" id="spinner-${agentMsgId}"></div>
            <span id="status-text-${agentMsgId}">Starting LangGraph workflow...</span>
          </div>
          <span class="badge badge-accent" id="round-badge-${agentMsgId}">Loop 1/3</span>
        </div>

        <div class="stepper-rounds" id="rounds-${agentMsgId}">
          <!-- Iteration rounds will append here -->
        </div>

        <div class="think-block" id="think-${agentMsgId}" style="display: none;">
          <details open>
            <summary>Thinking & Reasoning Process</summary>
            <div class="think-content" id="think-content-${agentMsgId}"></div>
          </details>
        </div>
      </div>

      <div class="report-content" id="report-${agentMsgId}">
        <p style="color: var(--muted); font-style: italic;">Researching live web sources...</p>
      </div>
    `;

    chatHistory.appendChild(agentMsg);
    chatHistory.scrollTop = chatHistory.scrollHeight;

    const statusText = document.getElementById(`status-text-${agentMsgId}`);
    const roundBadge = document.getElementById(`round-badge-${agentMsgId}`);
    const roundsContainer = document.getElementById(`rounds-${agentMsgId}`);
    const thinkBlock = document.getElementById(`think-${agentMsgId}`);
    const thinkContent = document.getElementById(`think-content-${agentMsgId}`);
    const reportContainer = document.getElementById(`report-${agentMsgId}`);
    const spinner = document.getElementById(`spinner-${agentMsgId}`);

    let activeRoundDiv = null;
    let currentRoundNum = 1;

    // Save user message immediately to current thread
    await saveThreadData(currentThreadId);
    await updateCurrentThreadMetadata(query);

    // Start SSE Stream with threadId
    if (activeEventSource) activeEventSource.close();
    const streamUrl = `/api/stream?input=${encodeURIComponent(query)}&threadId=${encodeURIComponent(currentThreadId)}`;
    activeEventSource = new EventSource(streamUrl);

    activeEventSource.onmessage = (event) => {
      try {
        const data = JSON.parse(event.data);

        if (data.type === 'error') {
          statusText.textContent = "Error: " + data.error;
          statusText.style.color = "var(--orange)";
          spinner.style.display = "none";
          cleanup();
          return;
        }

        if (data.type === 'step_start') {
          statusText.textContent = data.label;
          if (data.iteration) {
            currentRoundNum = data.iteration;
            roundBadge.textContent = `Loop ${currentRoundNum}/3`;
          }
          logTrace(data.step, data.label);
        }

        else if (data.type === 'thinking_chunk') {
          thinkBlock.style.display = 'block';
          thinkContent.textContent += data.chunk;
          thinkContent.scrollTop = thinkContent.scrollHeight;
          chatHistory.scrollTop = chatHistory.scrollHeight;
        }

        else if (data.type === 'query_planned') {
          roundBadge.textContent = `Loop ${data.iteration}/3`;

          activeRoundDiv = document.createElement('div');
          activeRoundDiv.className = 'round-node';
          activeRoundDiv.id = `round-${agentMsgId}-${data.iteration}`;
          activeRoundDiv.innerHTML = `
            <div class="round-badge-row">
              <span class="badge badge-accent">Round ${data.iteration} Search</span>
              <span class="search-pill">🔍 ${escapeHtml(data.query)}</span>
            </div>
            <div class="sources-tray" id="tray-${agentMsgId}-${data.iteration}"></div>
          `;
          roundsContainer.appendChild(activeRoundDiv);

          logTrace('planQuery', `Planned query: "${data.query}"`);
        }

        else if (data.type === 'sources_updated') {
          const existingUrls = new Set(allSources.map(s => s.url));
          (data.newSources || []).forEach(ns => {
            if (!existingUrls.has(ns.url)) {
              allSources.push(ns);
            }
          });
          renderSources();

          const tray = document.getElementById(`tray-${agentMsgId}-${data.iteration}`);
          if (tray) {
            tray.innerHTML = (data.newSources || []).map(s => `
              <a class="source-chip" href="${s.url}" target="_blank" rel="noopener noreferrer">
                <span>${extractDomain(s.url)}</span>
                <span class="pill-new">+NEW</span>
              </a>
            `).join('');
          }

          logTrace('searchTavily', `Found ${data.newCount} new sources (${data.totalCount} total accumulated)`);
        }

        else if (data.type === 'eval_decision') {
          const roundDiv = document.getElementById(`round-${agentMsgId}-${data.iteration}`) || activeRoundDiv;
          if (roundDiv) {
            const decisionDiv = document.createElement('div');
            decisionDiv.className = data.sufficient ? 'decision-box decision-sufficient' : 'decision-box decision-insufficient';
            decisionDiv.innerHTML = `
              <div class="decision-header">
                ${data.sufficient ? '✓ Research Concluded' : '⚡ Need Deeper Search'}
              </div>
              <div>${escapeHtml(data.reason)}</div>
              ${data.nextQuery ? `<div style="font-family: 'DM Mono', monospace; font-size: 11px; margin-top: 4px; color: var(--ink);">Next targeted query: "${escapeHtml(data.nextQuery)}"</div>` : ''}
            `;
            roundDiv.appendChild(decisionDiv);
          }

          logTrace('evaluateSufficiency', `Decision: ${data.sufficient ? 'SUFFICIENT' : 'INSUFFICIENT'} - ${data.reason}`);
        }

        else if (data.type === 'report_chunk') {
          reportContainer.innerHTML = md.render(data.chunk);
          chatHistory.scrollTop = chatHistory.scrollHeight;
        }

        else if (data.type === 'done') {
          spinner.style.display = 'none';
          statusText.textContent = `Completed in ${data.iterations} round(s) • ${data.sources.length} sources`;
          statusText.style.color = 'var(--accent)';

          if (data.finalReport) {
            reportContainer.innerHTML = md.render(data.finalReport);
          }

          logTrace('synthesizeReport', `Final synthesis complete (${data.sources.length} sources, ${data.knowledgeBase.length} KB cards)`);

          // Persist completed state to this thread
          saveThreadData(currentThreadId);
          updateCurrentThreadMetadata(data.finalReport || query);
          cleanup();
        }

        chatHistory.scrollTop = chatHistory.scrollHeight;
      } catch (err) {
        console.error("Stream parse error:", err, event.data);
      }
    };

    activeEventSource.onerror = () => {
      spinner.style.display = 'none';
      if (!statusText.textContent.includes('Completed')) {
        statusText.textContent = "Stream connection completed or closed.";
      }
      saveThreadData(currentThreadId);
      updateCurrentThreadMetadata();
      cleanup();
    };

    function cleanup() {
      if (activeEventSource) {
        activeEventSource.close();
        activeEventSource = null;
      }
      chatInput.disabled = false;
      btnSubmit.disabled = false;
      chatInput.focus();
    }
  });

  // ==========================================
  // INITIALIZATION ON PAGE LOAD
  // ==========================================
  window.addEventListener('DOMContentLoaded', async () => {
    const threads = await getStoredThreads();
    const savedActiveThreadId = localStorage.getItem('agentic_active_thread_id');

    if (threads.length > 0 && savedActiveThreadId && threads.some(t => t.id === savedActiveThreadId)) {
      // If user had an active thread open, restore that thread directly
      await showWorkspaceView(savedActiveThreadId);
    } else {
      // Otherwise, show the Initial Threads Hub listing all thread cards
      await showThreadsView();
    }
  });
</script>